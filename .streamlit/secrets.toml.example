# Salin file ini menjadi "secrets.toml" (tanpa .example) untuk tes lokal,
# ATAU tempel isinya di Streamlit Cloud → Settings → Secrets.
# JANGAN commit secrets.toml asli ke GitHub (sudah di-ignore).

DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
TELEGRAM_BOT_TOKEN = "isi-token-bot-telegram"
TELEGRAM_CHAT_ID = "isi-chat-id-telegram"
EXTENDED_BASE_URL = "https://api.starknet.extended.exchange"

# Salin ke .env lalu isi. JANGAN commit .env ke Git.

# CoinGecko Demo API (header x-cg-demo-api-key) — 10.000 call/bulan
COINGECKO_API_KEY=

# Etherscan V2 multichain — 1 key untuk banyak chain EVM
ETHERSCAN_API_KEY=

# Anthropic (L4 reasoning). Kosong = fallback template tanpa LLM.
ANTHROPIC_API_KEY=

# Telegram (L5). Kosong = notifikasi ke console + file outbox/.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL produksi, contoh:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/agent_signal
# Kosong = SQLite lokal (dev/test)
DATABASE_URL=

TZ=Asia/Jakarta

# Sumber derivatif M6: auto (binance->extended->coingecko) | binance | extended | coingecko
DERIVATIVES_PROVIDER=auto
EXTENDED_BASE_URL=https://api.starknet.extended.exchange
